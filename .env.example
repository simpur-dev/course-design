# 引据 CitationProof — copy to .env and fill only what you need.
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# --- seekdb (also used as the host port in docker-compose.yml) ---
YINJU_SEEKDB_HOST=127.0.0.1
YINJU_SEEKDB_PORT=2881
YINJU_SEEKDB_USER=root
YINJU_SEEKDB_PASSWORD=
YINJU_SEEKDB_DATABASE=yinju

# --- PowerContext (also used as the host port in docker-compose.yml) ---
YINJU_POWERCONTEXT_HOST=127.0.0.1
YINJU_POWERCONTEXT_PORT=8000
YINJU_POWERCONTEXT_TOKEN=
# YINJU_POWERCONTEXT_TIMEOUT=10
# 核对结束后写入项目记忆与 Handoff；PowerContext 不可用时核对仍会完成，并在报告里标注未写入。
YINJU_MEMORY_ENABLED=true

# --- models: the default path needs no API key ---
YINJU_EMBEDDING_PROVIDER=local
# none = extractive baseline (never emits "supported"); openai/anthropic need a key + model.
YINJU_VERIFIER_PROVIDER=none
YINJU_VERIFIER_MODEL=
YINJU_VERIFIER_TIMEOUT=60
YINJU_OPENAI_API_KEY=
YINJU_OPENAI_BASE_URL=
YINJU_ANTHROPIC_API_KEY=
YINJU_ANTHROPIC_BASE_URL=

# --- app ---
YINJU_DATA_DIR=data
YINJU_LOG_LEVEL=INFO
YINJU_WEB_HOST=127.0.0.1
YINJU_WEB_PORT=8787
# YINJU_WEB_DIR=web/dist

# --- optional: reuse an existing PowerContext image instead of building one ---
# YINJU_POWERCONTEXT_IMAGE=powercontext-server:1.4.0
