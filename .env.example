# 引据 CitationProof — copy to .env and fill only what you need.
# Windows: copy .env.example .env
# Linux/macOS: cp .env.example .env

# --- seekdb (also used as the host port in docker-compose.yml) ---
APP_SEEKDB_HOST=127.0.0.1
APP_SEEKDB_PORT=2881
APP_SEEKDB_USER=root
APP_SEEKDB_PASSWORD=
APP_SEEKDB_DATABASE=course_design

# --- PowerContext (also used as the host port in docker-compose.yml) ---
APP_POWERCONTEXT_HOST=127.0.0.1
APP_POWERCONTEXT_PORT=8000
APP_POWERCONTEXT_TOKEN=
# APP_POWERCONTEXT_TIMEOUT=10
# 核对结束后写入项目记忆与 Handoff；PowerContext 不可用时核对仍会完成，并在报告里标注未写入。
APP_MEMORY_ENABLED=true

# --- models: the default path needs no API key ---
APP_EMBEDDING_PROVIDER=local
# none = extractive baseline (never emits "supported"); openai/anthropic need a key + model.
APP_VERIFIER_PROVIDER=none
APP_VERIFIER_MODEL=
APP_VERIFIER_TIMEOUT=60
APP_OPENAI_API_KEY=
APP_OPENAI_BASE_URL=
APP_ANTHROPIC_API_KEY=
APP_ANTHROPIC_BASE_URL=

# --- app ---
APP_DATA_DIR=data
APP_LOG_LEVEL=INFO
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8787
# APP_FRONTEND_DIR=frontend/dist

# --- optional: reuse an existing PowerContext image instead of building one ---
# APP_POWERCONTEXT_IMAGE=powercontext-server:1.4.0
